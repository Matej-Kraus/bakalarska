TRAINERAPP_SECRET_KEY=change-me-in-production
TRAINERAPP_JWT_ALGORITHM=HS256
TRAINERAPP_ACCESS_TOKEN_EXP_MINUTES=1440

# Local dev (SQLite)
# TRAINERAPP_DATABASE_URL=sqlite:///./app.db

# Production (PostgreSQL)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
TRAINERAPP_DATABASE_URL=postgresql+psycopg://trainerapp:strongpassword@127.0.0.1:5432/trainerapp

# Frontend URL (used in emails and redirects)
TRAINERAPP_FRONTEND_BASE_URL=http://127.0.0.1:5173

# SMTP (optional now, can stay empty)
TRAINERAPP_SMTP_HOST=
TRAINERAPP_SMTP_PORT=587
TRAINERAPP_SMTP_USER=
TRAINERAPP_SMTP_PASSWORD=
TRAINERAPP_SMTP_FROM_EMAIL=
TRAINERAPP_SMTP_USE_TLS=true
